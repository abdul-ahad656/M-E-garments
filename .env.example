# Server
PORT=8080
NODE_ENV=development

# Shopify (required for catalog/cart)
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Required for account order history
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Supabase (required for profiles/wishlist/admin app data)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# AI assistant
OPENAI_API_KEY=
OPENAI_PROVIDER_READY=true

# Clerk (server)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Frontend (also used by Vite — put these in artifacts/me-garments/.env if preferred)
VITE_CLERK_PUBLISHABLE_KEY=
# Optional; defaults shown
# BASE_PATH=/
# API_PROXY_TARGET=http://127.0.0.1:8080
