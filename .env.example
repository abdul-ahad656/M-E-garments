# Server
# Use 3001 locally — Apache/XAMPP often already binds 8080 on Windows.
PORT=3001
NODE_ENV=development

# Store currency for carts and orders (ISO 4217)
STORE_CURRENCY=PKR

# Cloudflare R2 (product image file storage; public URLs saved on product_images)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=me-garments-products
# Public bucket URL or custom domain, no trailing slash
# e.g. https://pub-xxxxx.r2.dev or https://media.yourdomain.com
R2_PUBLIC_BASE_URL=

# Supabase (commerce catalog, carts, orders + profiles/wishlist/admin app data)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# AI assistant
OPENAI_API_KEY=
OPENAI_PROVIDER_READY=true

# Optional on-model product image generation (server-side only; never expose to Vite)
GEMINI_API_KEY=
# Optional overrides
# IMAGE_GENERATION_PYTHON=py -3
# IMAGE_GENERATION_MODULE_PATH=

# Clerk (server)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Frontend (also used by Vite — put these in artifacts/me-garments/.env if preferred)
VITE_CLERK_PUBLISHABLE_KEY=
# Optional; defaults shown
# BASE_PATH=/
# API_PROXY_TARGET=http://127.0.0.1:3001
