{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run build --workspaces --if-present",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspaces --if-present",
    "validate": "npm run test:commerce -w @workspace/api-server",
    "dev:web": "npm run dev -w @workspace/me-garments",
    "dev:api": "npm run dev -w @workspace/api-server",
    "codegen": "npm run codegen -w @workspace/api-spec"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
